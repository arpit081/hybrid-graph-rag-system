ENTITIES_CSV_PATH=https://raw.githubusercontent.com/arpit081/hybrid-graph-rag-system/main/data/hospitals.csv
PAYERS_CSV_PATH=https://raw.githubusercontent.com/arpit081/hybrid-graph-rag-system/main/data/payers.csv
PHYSICIANS_CSV_PATH=https://raw.githubusercontent.com/arpit081/hybrid-graph-rag-system/main/data/physicians.csv
PATIENTS_CSV_PATH=https://raw.githubusercontent.com/arpit081/hybrid-graph-rag-system/main/data/patients.csv
VISITS_CSV_PATH=https://raw.githubusercontent.com/arpit081/hybrid-graph-rag-system/main/data/visits.csv
REVIEWS_CSV_PATH=https://raw.githubusercontent.com/arpit081/hybrid-graph-rag-system/main/data/reviews.csv
EXAMPLE_CYPHER_CSV_PATH=https://raw.githubusercontent.com/arpit081/hybrid-graph-rag-system/main/data/example_cypher.csv

# Neo4j credentials
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password

# LLM Provider Configuration ('openai' or 'ollama')
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key

# Optional settings
ENTERPRISE_AGENT_MODEL=gpt-4o-mini
ENTERPRISE_CYPHER_MODEL=gpt-4o-mini
ENTERPRISE_QA_MODEL=gpt-4o-mini
